# Copy to .env (gitignored) for the live tests: go test -tags live -run Live -v ./...
# Either a username and password (the client logs in and renews tokens)...
CREDITSAFE_USERNAME=
CREDITSAFE_PASSWORD=
# ...or a token you already have (lasts about an hour, not renewed).
CREDITSAFE_TOKEN=
